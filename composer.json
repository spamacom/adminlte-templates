{
    "name": "spamacom/adminlte-templates",
    "type": "library",
    "description": "AdminLTE templates for Laravel Generator",
    "keywords": [
        "spama",
        "laravel",
        "generator",
        "adminlte",
        "templates",
        "bootstrap"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Mouhammad Alali",
            "email": "mouhammad.alali@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4|^8.5",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0",
        "spamacom/laravel-ui-adminlte": "^5.2"
    },
    "autoload": {
        "psr-4": {
            "InfyOm\\AdminLTETemplates\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InfyOm\\AdminLTETemplates\\AdminLTETemplatesServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
